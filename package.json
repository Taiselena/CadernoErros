{
  "name": "caderno-erros-tais-elena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulador": "vite --mode emulador",
    "emuladores": "firebase emulators:start --project demo-caderno",
    "build": "tsc --noEmit && vite build",
    "build:emulador": "tsc --noEmit && vite build --mode emulador",
    "preview": "vite preview",
    "test": "vitest run tests/logica.test.ts",
    "test:regras": "firebase emulators:exec --only firestore --project demo-caderno \"vitest run tests/regras.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
