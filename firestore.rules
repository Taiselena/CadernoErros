rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada conta lê e grava somente os próprios dados: usuarios/{uid} e tudo abaixo.
    match /usuarios/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Opcional: para permitir apenas contas específicas, troque a regra acima por:
    // allow read, write: if request.auth != null && request.auth.uid == uid
    //   && request.auth.token.email in ['taiselena759@gmail.com'];
  }
}
